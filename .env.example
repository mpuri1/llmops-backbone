# Copy to .env and fill in.
GOOGLE_API_KEY=
# Gateway: any random string; clients send it as the bearer token.
LLMOPS_GATEWAY_KEY=
LLMOPS_GATEWAY_URL=http://localhost:4000
# Azure OpenAI alias "azure-gpt" (optional): endpoint, key, API version, and azure/<deployment-name>.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_GATEWAY_MODEL=
